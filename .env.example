# At least one provider below is required. RAG embeddings run on a free
# local model, so nothing here affects retrieval, only the 3 CrewAI agents'
# chat calls. LLM_PROVIDERS controls which providers are tried and in what
# order; a provider with no API key set is skipped automatically.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Optional: DeepSeek as an alternative/fallback chat provider.
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Optional: Kimi (Moonshot) as an alternative/fallback chat provider.
# KIMI_API_KEY=sk-...
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=moonshot-v1-8k

# LLM_PROVIDERS=openai,deepseek,kimi

# Optional: shared secret required on the /webhook/hris endpoint via an
# X-Webhook-Secret header. Left unset, the webhook is open (fine for local
# development and the sample n8n workflow).
# WEBHOOK_SECRET=change-me

# CrewAI's own telemetry/tracing are disabled by default (see pipeline.py);
# uncomment to opt back in, e.g. to use CrewAI's tracing dashboard locally.
# CREWAI_DISABLE_TELEMETRY=false
# CREWAI_TRACING_ENABLED=true

# Optional: print each agent's full reasoning/tool-call trace to the
# console. Useful when watching a run locally, pure overhead in production.
# CREWAI_VERBOSE=true
